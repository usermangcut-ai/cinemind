# Copy file này thành backend/.env rồi điền key.

# Bước 1 — kéo dữ liệu phim (bắt buộc). Máy phải bật Cloudflare WARP / DNS 1.1.1.1 (nhà mạng chặn TMDB)
# themoviedb.org → Settings → API → "API Read Access Token" (chuỗi dài bắt đầu bằng eyJ...)
TMDB_READ_TOKEN=

# LLM — provider OpenAI-compatible
LLM_BASE_URL=https://api.shopaikey.com/v1
LLM_API_KEY=
# (tuỳ chọn) key riêng cho embedding + Jev; trống = dùng LLM_API_KEY
AUX_API_KEY=
LLM_MODEL_PARSE=gpt-4.1-mini
LLM_MODEL_ONLINE=gpt-4.1-mini
LLM_MODEL_OFFLINE=gpt-4.1-mini

# Bước ⑥ rerank: jev | llm. Jev gọi qua provider LLM (/v1/systemone); TYPESAFE_API_KEY chỉ cần nếu dùng TypeSafe gốc
RERANK=jev
JEV_CONCURRENCY=20
JEV_TOP=40
POOL_N=40
TYPESAFE_API_KEY=

# Database (giữ nguyên, Docker tự tạo)
DATABASE_URL=postgresql://cinemind:cinemind@localhost:5432/cinemind

# Embedding — chọn theo bài so sánh docs/steps/02-embedding.md
EMBED_MODEL=gemini-embedding-001
